<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>StratagemHelper</AssemblyName>
    <RootNamespace>StratagemHelper</RootNamespace>
    <Version>1.3.1</Version>
    <Product>Stratagem Helper</Product>
    <Description>Accessibility companion for Helldivers 2</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Speech" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Chakra Petch (SIL Open Font License, see Fonts\OFL.txt): the heading font, shared with the website. -->
    <EmbeddedResource Include="Fonts\*.ttf;Fonts\OFL.txt" LogicalName="StratagemHelper.Fonts.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
